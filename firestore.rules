rules_version = '2';

// Paste this into: Firebase console → Firestore Database → Rules tab → Publish.
// Only the email addresses in the list can read or write anything. Everyone else is blocked.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && request.auth.token.email in [
          'fahimshahrear.3111@gmail.com',
          'second.person@example.com'   // ← replace with your partner's login email
        ];
    }

    match /{collection}/{docId} {
      allow read, write: if isStaff();
    }
  }
}
